<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="email_template_purchase_requisition" model="mail.template">
        <field name="name">Purchase Contract: Send by email</field>
        <field name="model_id" ref="purchase_requisition.model_purchase_requisition" />
        <field
            name="subject"
        >Purchase contract {{ object.name or 'n/a' }} ready for review</field>
        <field
            name="email_from"
        >{{ object.user_id.email_formatted or user.email_formatted }}</field>
        <field name="partner_to">{{ object.vendor_id.id }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear <t t-out="object.vendor_id.name or ''">Vendor Name</t>,
                    <br /><br />
                    Your purchase contract <strong><t
                            t-out="object.name or 'n/a'"
                        >Contract Name</t></strong> is ready for review.
                    <br /><br />
                    <t t-if="object.user_id.signature">
                        <br /><br />
                        <t t-out="object.user_id.signature or ''">--<br
                            />User Signature</t>
                    </t>
                    <br /><br />
                    Do not hesitate to contact us if you have any questions.
                </p>
            </div>
        </field>
        <field
            name="report_template_ids"
            eval="[(4, ref('purchase_requisition.action_report_purchase_requisitions'))]"
        />
        <field name="lang">{{ object.vendor_id.lang }}</field>
        <field name="auto_delete" eval="True" />
    </record>
</odoo>
