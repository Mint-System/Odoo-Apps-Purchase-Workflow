<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_purchase_requisition_form" model="ir.ui.view">
        <field
            name="name"
        >purchase_requisition_other_information_page.view_purchase_requisition_form</field>
        <field name="model">purchase.requisition</field>
        <field
            name="inherit_id"
            ref="purchase_requisition.view_purchase_requisition_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Other Information" name="other_information">
                    <group>
                        <group name="other_info">
                            <!-- Modify or remove the domain or adjust field visibility based on group -->
                            <field
                                name="user_id"
                                domain="[('share', '=', False)]"
                                widget="many2one_avatar_user"
                            />
                            <!-- Ensure company_id field is properly managed regarding multi-company setups -->
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                options="{'no_create': True}"
                            />
                        </group>
                        <group name="invoice_info">
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
